# QEMU / Secure Graphics Additions Fragment of linux defconfigs (applied on top of the linux arm64 base defconfig)


CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ARM UART Serial Console Driver
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Enable Modules Support
CONFIG_MODULES=y

## OP-TEE/QEMU Support
CONFIG_TEE=y
CONFIG_OPTEE=y

## Enable 9P VFS
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

## Virtio RNG
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

## EFI
CONFIG_EFI_GENERIC_STUB_INITRD_CMDLINE_LOADER=y

## Debugging
CONFIG_GDB_SCRIPTS=y

## Keys
CONFIG_KEYS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_ENCRYPTED_KEYS=y

## FF-A
CONFIG_ARM_FFA_TRANSPORT=y

## TPM
CONFIG_TCG_TPM=y
CONFIG_TCG_FTPM_TEE=y

## Networking
CONFIG_IPV6=y

# DRM
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_TTM=y
CONFIG_DRM_TTM_HELPER=y
CONFIG_DRM_VRAM_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_DISPLAY_HELPER=y

# Debugging & Tracing Infra
CONFIG_DEBUG_FS=y
CONFIG_TRACING=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_EVENT_TRACING=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_STACKTRACE=y
CONFIG_FRAME_POINTER=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_PERF_EVENTS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_DEBUG_KERNEL=y

# Linux Secure Graphics Patch
CONFIG_DRM_SECURE_GRAPHICS=y

# Linux Secure Graphics OPTEE Driver Additions
CONFIG_OPTEE_SECURE_GRAPHICS_DRIVERS=y
CONFIG_OPTEE_SECURE_GRAPHICS_TEST=y
